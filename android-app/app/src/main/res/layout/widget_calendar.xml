<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cal_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/cal_widget_left_panel"
        android:layout_width="104dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_calendar_grad"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/cal_widget_month_wd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 今日日程"
            android:textColor="#CCFBF1"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cal_widget_day_num"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="--"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cal_widget_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="今日 0 项排期"
            android:textColor="#F0FDFA"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cal_widget_open_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🗓️ 周时间轴"
            android:textColor="#FFFFFF"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cal_widget_right_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="今日时间段与全天日程"
                android:textColor="#475569"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cal_widget_refresh_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:text="↻ 刷新"
                android:textColor="#0D9488"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/cal_widget_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="正在同步今日日程…"
            android:textColor="#0F172A"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cal_widget_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#334155"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/cal_widget_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#334155"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
